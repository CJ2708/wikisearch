# Copy this file to ".env" and fill in values for LOCAL development.
#   cp .env.example .env
#
# In production (Render/HF Spaces) you set these in the host's dashboard
# instead — never commit a real .env file (it's in .gitignore).

# Which LLM backend to use: "ollama" (local), "groq" (cloud), or "auto".
# "auto" uses Groq when GROQ_API_KEY is set, otherwise local Ollama.
LLM_PROVIDER=auto

# --- Groq (hosted open models, free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Local Ollama (defaults shown; only used when provider resolves to ollama) ---
OLLAMA_MODEL=llama3.2

# --- Search source: "web" (Tavily) or "wikipedia" ---
SEARCH_SOURCE=web

# --- Web search (Tavily — free key at https://app.tavily.com) ---
# Required for web search. Without it, the engine falls back to Wikipedia.
TAVILY_API_KEY=

# How many candidate documents to consider per query.
CANDIDATE_ARTICLES=8
